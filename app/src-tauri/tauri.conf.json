{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "محرر الفيديو",
  "mainBinaryName": "arabic-video-editor",
  "version": "0.1.0",
  "identifier": "app.arabicvideoeditor.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "محرر الفيديو",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "backgroundColor": "#1c1d20"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data: asset: http://asset.localhost",
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app", "deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "../../assets/fonts/": "fonts/" },
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "category": "Video",
    "shortDescription": "محرر فيديو عربي أولاً"
  }
}
